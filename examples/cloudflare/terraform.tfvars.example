# Copy to terraform.tfvars and populate. Auth: gcloud auth application-default login.
project_id           = "my-gcp-project-id"
gcp_region           = "us-east4" # any region; e.g. us-east4 (N. Virginia), europe-west3 (Frankfurt), europe-west1 (Belgium)
gcs_location         = "US"       # keep near gcp_region: US for us-*, EU for europe-*, or a specific region
friendly_name_prefix = "dev"
n8n_fqdn           = "n8n.example.com"

n8n_license_key = "your-enterprise-license-key"

# Cloudflare (zone that owns n8n_fqdn) + ACME
cloudflare_zone_id   = "your-cloudflare-zone-id"
cloudflare_api_token = "cf-token-with-Zone.DNS-Edit" # sensitive
acme_email           = "you@example.com"

# While testing, use the Let's Encrypt STAGING directory to avoid prod rate limits:
# acme_server = "https://acme-staging-v02.api.letsencrypt.org/directory"

# Let Terraform disable iam.disableServiceAccountKeyCreation for the GCS HMAC key.
# Requires org-policy admin rights; otherwise leave false and disable it manually.
# manage_sa_key_org_policy = true

# ── TLS-inspecting egress proxy / TLS-terminating proxy in front (optional) ──
# See docs/tls-proxy.md in the module root.
# n8n_extra_ca_pem = "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"  # or pass -var "n8n_extra_ca_pem=$(cat proxy-ca.pem)"
# n8n_proxy_hops   = 2
# n8n_extra_env = [
#   { name = "HTTPS_PROXY", value = "http://proxy.corp.example:3128" },
#   { name = "NO_PROXY",    value = "localhost,127.0.0.1,.svc,.cluster.local,.googleapis.com,metadata.google.internal" },
# ]
