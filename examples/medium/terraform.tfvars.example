# Copy to terraform.tfvars and populate. Auth: gcloud auth application-default login.
project_id           = "my-gcp-project-id"
gcp_region           = "us-east4" # any region; e.g. us-east4 (N. Virginia), europe-west3 (Frankfurt), europe-west1 (Belgium)
gcs_location         = "US"       # keep near gcp_region: US for us-*, EU for europe-*, or a specific region
friendly_name_prefix = "medium"
n8n_fqdn           = "n8n.example.com"
n8n_license_key      = "your-enterprise-license-key"
cloud_dns_zone_name     = "my-cloud-dns-zone" # empty = manage the A-record yourself

# Let Terraform disable iam.disableServiceAccountKeyCreation for the GCS HMAC key.
# Requires org-policy admin rights; otherwise leave false and disable it manually.
# manage_sa_key_org_policy = true

# Pin the n8n version. Unset, the chart's floating `stable` tag is used and pods
# may pick up a new n8n release on any restart. Recommended for anything beyond
# a throwaway evaluation.
# n8n_image_tag = "2.39.7"

# ── Sizing (medium) , override any of these; defaults shown ───────────────────
# postgres_machine_type                   = "db-custom-4-15360"
# postgres_disk_size              = 100
# postgres_availability_type      = "REGIONAL"
# redis_tier                = "STANDARD_HA"
# redis_memory_size_gb           = 4
# gke_node_type               = "e2-standard-8"
# gke_node_min_per_zone               = 2
# gke_node_max_per_zone               = 5
# gke_node_disk_size_gb           = 100
# gke_node_disk_type              = "pd-balanced"
# db_postgresdb_pool_size         = 10
# n8n_worker_concurrency          = 15
# n8n_worker_keda_min_replicas    = 2
# n8n_worker_keda_max_replicas    = 30
# n8n_webhook_hpa_min_replicas    = 3
# n8n_webhook_hpa_max_replicas    = 40
# n8n_execution_concurrency_limit = 200
