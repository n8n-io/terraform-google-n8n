# Copy to terraform.tfvars and populate. Auth: gcloud auth application-default login.
project_id           = "my-gcp-project-id"
gcp_region           = "us-east4" # any region; e.g. us-east4 (N. Virginia), europe-west3 (Frankfurt), europe-west1 (Belgium)
gcs_location         = "US"       # keep near gcp_region: US for us-*, EU for europe-*, or a specific region
friendly_name_prefix = "dev"
n8n_fqdn           = "n8n.example.com"
n8n_license_key      = "your-enterprise-license-key"
# Offline license activation instead of a key (air-gapped clusters): delete
# the n8n_license_key line above and reference a Secret you created in the n8n
# namespace. The certificate covers initial activation only: for a fully
# offline cluster, also disable N8N_LICENSE_AUTO_RENEW_ENABLED, block egress to
# n8n's license server, and request a replacement certificate before the
# current one expires. See the root README, "Offline license activation".
# n8n_license_cert_secret_ref = { name = "n8n-license-cert", key = "cert" }
cloud_dns_zone_name     = "my-cloud-dns-zone" # empty = manage the A-record yourself

# Let Terraform disable iam.disableServiceAccountKeyCreation for the GCS HMAC key.
# Requires org-policy admin rights; otherwise leave false and disable it manually.
# manage_sa_key_org_policy = true

# Pin the n8n version. Unset, the chart's own default tag is used: its appVersion
# (2.43.5 at chart 1.16.0), which only moves when the module's n8n_chart_version
# does. Pin it to upgrade n8n independently of the chart.
# n8n_image_tag = "2.39.7"

# The small tier uses the module's defaults (no sizing overrides needed). See
# examples/medium and examples/large for the tunable sizing variables.

# ── TLS-inspecting egress proxy / TLS-terminating proxy in front (optional) ──
# See docs/tls-proxy.md in the module root.
# n8n_extra_ca_pem = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
# EOT
# n8n_proxy_hops   = 2  # only when a proxy/WAF sits in front of n8n's ingress; count the Google Cloud load balancer too; omit for an egress-only proxy
# n8n_extra_env = [
#   { name = "HTTPS_PROXY", value = "http://proxy.corp.example:3128" },
#   { name = "HTTP_PROXY",  value = "http://proxy.corp.example:3128" },
#   { name = "NO_PROXY",    value = "localhost,127.0.0.1,.svc,.cluster.local,.googleapis.com,metadata.google.internal" },
# ]
