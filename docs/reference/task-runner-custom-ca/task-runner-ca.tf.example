# Reference snippet: wire a custom task-runner image and launcher
# configuration into terraform-google-n8n so the JavaScript task runner
# trusts a private/proxy CA.
#
# Copy this into your own root module alongside your `module "n8n"` block.
# It assumes:
#   - A `kubernetes` provider already configured against the same GKE
#     cluster the module deploys to (see
#     examples/customer-managed-cluster/providers.tf for the pattern).
#   - n8n-task-runners.json (or n8n-task-runners.test.json, to reproduce the
#     verification in README.md) copied next to this file.
#   - A custom task-runner image already built and pushed; see README.md.

# Must match the module's own n8n_kube_namespace input (default "n8n").
# Referencing module.n8n's namespace output here would create a
# dependency cycle, because the module also needs this ConfigMap's name.
locals {
  n8n_kube_namespace = "n8n"
}

resource "kubernetes_config_map_v1" "task_runner_launcher_config" {
  metadata {
    name      = "n8n-task-runner-launcher-config"
    namespace = local.n8n_kube_namespace
  }

  data = {
    "n8n-task-runners.json" = file("${path.module}/n8n-task-runners.json")
  }
}

module "n8n" {
  # source  = "..."
  # version = "..."

  # ... your other inputs ...

  n8n_task_runner_image_repository = "us-east4-docker.pkg.dev/<project>/<repo>/runners"
  # Bump this tag's suffix (e.g. -ca-v1, -ca-v2) on every CA rotation so
  # Kubernetes always pulls the new image instead of reusing a cached layer.
  n8n_task_runner_image_tag = "<n8n-version>-ca-v1"

  n8n_task_runner_custom_config = {
    config_map_name = kubernetes_config_map_v1.task_runner_launcher_config.metadata[0].name
  }
}
